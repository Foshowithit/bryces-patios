# Full-size PNG originals — 28 MB, never requested by the site.
# Keep them locally, don't ship them.
_masters/

# macOS
.DS_Store
._*

# Editor cruft
*.swp

# local working/scratch files — but the site generator SHIPS (it is the build)
work/*
!work/gen/
!work/indexnow-ping.sh
!work/.indexnow-key
work/gen/__pycache__/

# Pre-grading negatives — the input grade-photos.py reads, never requested by the
# site. 9.5 MB of it. Rebuild the shipped files from these, don't ship them.
assets/img/_orig/

# Bytecode from the build scripts
tools/__pycache__/
